# Build outputs
*.exe

# Node dependencies (web-panel build artifacts — not part of the repo per ALL-243)
node_modules/

# Runtime logs
*.log

# Health-check scratch
health-response.txt

# Local environment (keep .env.example tracked)
.env

# Agent runtime scratch — never index these.
# The npm cache stores content-addressed sha512 paths that exceed the Windows
# 260-char limit, which makes `git add` fail with "Filename too long" and
# aborts the whole run (ALL-155 run 01a03859).
.npm-cache-multica/
.agent_context/
.multica/
.claude/
.codebuddy/
.all199/
# A repo-local GOCACHE holds content-addressed build entries whose CRLF/LF
# conversion breaks `git add` and fails the run (ALL-157 run 01a03a3e).
.gocache/

# Coverage artifacts
coverage.out
*_coverage.out
