# ============================================
# Memory Gateway 环境变量配置示例
# ============================================
#
# 使用方法：
#   1. 复制本文件为 .env
#   2. 修改路径和端口为你的实际配置
#   3. 不要提交 .env 到版本控制系统
#

# --------------------------------------------
# 核心配置
# --------------------------------------------

# 数据根目录（必填）
# 所有运行时数据、团队数据、录入文件都存储在此目录下
# Windows 示例: F:\memory_plus
# Linux/macOS 示例: /home/user/memory_plus
MEMORY_PLUS_DIR=F:\memory_plus

# Gateway 服务监听端口（默认 8096）
GATEWAY_PORT=8096

# --------------------------------------------
# 数据库配置
# --------------------------------------------

# 全局数据库路径（可选，默认为 MEMORY_PLUS_DIR/.runtime/memory-gateway.db）
# 存储：团队、API Key、幂等性缓存、录入健康记录
GLOBAL_DB_PATH=F:\memory_plus\.runtime\memory-gateway.db

# 团队数据库目录（可选，默认为 MEMORY_PLUS_DIR/90_运行数据/teams）
# 每个团队在此目录下有独立的子目录和数据库
TEAMS_DIR=F:\memory_plus\90_运行数据\teams

# --------------------------------------------
# 上游 LLM 配置
# --------------------------------------------

# Models.json 路径（可选）
# 包含上游 LLM 模型配置（厂商、协议、优先级）
# 如不设置，将从 MEMORY_PLUS_DIR/00_系统/models.json 读取
MODELS_JSON_PATH=F:\memory_plus\00_系统\models.json

# 上游 API Key 存储目录（必填）
# 存储加密的上游 LLM API Key（Anthropic/OpenAI/Codex）
# 文件格式：<team_id>_<channel_name>.key
SECRETS_DIR=F:\memory_plus\.runtime\secrets

# --------------------------------------------
# 录入配置
# --------------------------------------------

# L0 录入根目录（可选，默认为 MEMORY_PLUS_DIR/L0_每一轮记录）
# 所有 LLM 对话自动记录到此目录下（按日期分组）
L0_DIR=F:\memory_plus\L0_每一轮记录

# 录入缓冲区目录（可选，默认为 MEMORY_PLUS_DIR/.runtime/outbox）
# 当 L0 写入失败时，先写入 buffer，稍后重试
OUTBOX_DIR=F:\memory_plus\.runtime\outbox

# 是否启用录入（可选，默认 true）
# 设为 false 可禁用 L0 录入，仅保留网关代理功能
RECORDING_ENABLED=true

# --------------------------------------------
# 日志配置
# --------------------------------------------

# 日志级别（可选，默认 info）
# 可选值: debug, info, warn, error
LOG_LEVEL=info

# 日志格式（可选，默认 json）
# 可选值: json, text
LOG_FORMAT=json

# --------------------------------------------
# 安全配置
# --------------------------------------------

# Bearer Token 有效期（可选，默认 24 小时，单位：秒）
# API Key 校验时检查 expires_at 字段
TOKEN_EXPIRY_SECONDS=86400

# 幂等性缓存过期时间（可选，默认 24 小时，单位：秒）
# Idempotency-Key 缓存保留时间
IDEMPOTENCY_CACHE_TTL=86400

# 允许的跨域来源（可选，默认 *）
# 生产环境建议设置为前端域名，如：https://your-domain.com
CORS_ALLOWED_ORIGINS=*

# --------------------------------------------
# MCP Server 配置（仅 MCP 客户端需要）
# --------------------------------------------

# MCP Server 监听端口（可选，默认 8097）
MCP_SERVER_PORT=8097

# Gateway 内部地址（可选，默认 http://127.0.0.1:8096）
# MCP Server 通过此地址调用 Gateway API
GATEWAY_INTERNAL_URL=http://127.0.0.1:8096

# --------------------------------------------
# Web 面板配置（仅开发环境需要）
# --------------------------------------------

# Web 面板开发服务器端口（可选，默认 5173）
# 仅 npm run dev 时生效
WEB_PANEL_DEV_PORT=5173

# Gateway 基础 URL（可选，默认为空，由 Vite 代理）
# 生产环境可设置为 Gateway 公网地址
# 开发环境留空，Vite 会代理 /api 请求到 127.0.0.1:8096
VITE_GATEWAY_BASE=

# --------------------------------------------
# 高级配置（通常无需修改）
# --------------------------------------------

# SQLite Busy Timeout（可选，默认 5000ms）
# 数据库锁等待超时时间
SQLITE_BUSY_TIMEOUT=5000

# SQLite Journal Mode（可选，默认 WAL）
# 可选值: DELETE, TRUNCATE, PERSIST, MEMORY, WAL, OFF
SQLITE_JOURNAL_MODE=WAL

# Worker 并发数（可选，默认 CPU 核心数）
# 后台任务队列的 Goroutine 数量
WORKER_CONCURRENCY=4

# Watchdog 检查间隔（可选，默认 60 秒）
# 健康检查和自动修复的执行间隔
WATCHDOG_INTERVAL=60

# 请求超时时间（可选，默认 120 秒）
# 上游 LLM API 调用超时时间
UPSTREAM_REQUEST_TIMEOUT=120

# 重试次数（可选，默认 3 次）
# 上游 LLM API 调用失败时的重试次数
UPSTREAM_MAX_RETRIES=3

# --------------------------------------------
# 示例：完整的生产环境配置
# --------------------------------------------
#
# MEMORY_PLUS_DIR=/opt/memory_plus
# GATEWAY_PORT=8096
# LOG_LEVEL=warn
# LOG_FORMAT=json
# CORS_ALLOWED_ORIGINS=https://your-domain.com
# RECORDING_ENABLED=true
# SECRETS_DIR=/opt/memory_plus/.runtime/secrets
# MODELS_JSON_PATH=/opt/memory_plus/00_系统/models.json
#
