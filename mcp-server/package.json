{
  "name": "memory-gateway-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Memory Gateway MVP — MCP Server (stdio + Streamable HTTP :8097)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport http",
    "start:stdio": "node dist/index.js --transport stdio",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --transport http",
    "dev:stdio": "tsx src/index.ts --transport stdio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^4.19.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
